{
  "name": "odata-lite",
  "version": "0.1.0",
  "description": "A lightweight, whitelist-driven parser for a safe subset of OData $filter syntax, translating to MongoDB queries.",
  "license": "MIT",
  "keywords": [
    "odata",
    "filter",
    "query",
    "parser",
    "mongodb"
  ],
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.12.1",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "example:basic": "tsx examples/basic-usage.ts",
    "example:api": "tsx examples/api-integration.ts"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/chai": "^4.3.20",
    "@types/chai-as-promised": "^8.0.2",
    "@types/node": "^22.0.0",
    "@eslint/js": "^9.17.0",
    "@vitest/coverage-v8": "^2.1.8",
    "chai": "^4.5.0",
    "chai-as-promised": "^7.1.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "moment": "^2.30.1",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
